{
  "kind": "web_search",
  "version": "0.1.0",
  "title": "Web Search",
  "description": "Search the web with SearXNG, Brave or SerpAPI, and Wikipedia.",
  "repository_url": "https://github.com/HackInvent/bloxmith-web-search",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "prerequisites": [
    {
      "type": "manual",
      "name": "Linux/POSIX with Python 3.10+ and TLS support, and outbound HTTPS to the chosen provider: a SearXNG instance with the json format enabled, api.search.brave.com with a Brave Search API subscription token stored in the BloxSmith wallet, serpapi.com with a SerpAPI key stored in the wallet, or <language>.wikipedia.org (no key)."
    }
  ],
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "query",
        "title": "query",
        "accepts": [
          "text/plain",
          "application/json",
          "message/*"
        ],
        "multiplicity": "one",
        "required": true,
        "execution_requirement": "required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "results",
        "title": "results",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 2,
        "name": "error",
        "title": "error",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "enabled": false,
    "provider": "wikipedia",
    "secret_ref": "",
    "searxng_url": "",
    "allow_private_network": false,
    "allow_insecure_http": false,
    "count": 10,
    "language": "",
    "region": "",
    "safe_search": "moderate",
    "time_range": "",
    "timeout_sec": 20,
    "max_pages": 3,
    "max_retries": 2,
    "max_retry_wait_sec": 20,
    "max_response_bytes": 2097152,
    "max_text_chars": 4000,
    "api_base_url": "",
    "ca_file": ""
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "all_inputs",
    "active_execution_policy": "on_each_event",
    "file_browser": false
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "css",
        "path": "assets/css/settings.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "css",
        "path": "assets/css/settings.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/node_card.css"
      }
    ]
  }
}
